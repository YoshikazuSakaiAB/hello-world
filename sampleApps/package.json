{
  "name": "markdown-preview-extension",
  "version": "0.1.0",
  "description": "Markdown プレビュー Edge 拡張機能（SPEC-001）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "encoding-japanese": "^2.2.0",
    "js-yaml": "^5.2.1",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/dompurify": "^3.0.5",
    "@types/encoding-japanese": "^2.2.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
