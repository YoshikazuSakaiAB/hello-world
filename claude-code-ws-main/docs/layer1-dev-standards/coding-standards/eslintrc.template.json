{
  "_comment": "ESLint 設定の雛形。各プロジェクトで言語・FWに合わせて差し替えてください。XP基準（関数50行/複雑度10）を機械的に強制することが主眼です。",
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "max-lines-per-function": ["error", { "max": 50, "skipBlankLines": true, "skipComments": true }],
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],
    "complexity": ["error", 10],
    "max-depth": ["error", 4],
    "max-params": ["warn", 4],
    "no-magic-numbers": ["warn", { "ignore": [-1, 0, 1], "ignoreArrayIndexes": true }],
    "no-console": "warn",
    "eqeqeq": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "ignorePatterns": ["dist/", "build/", "node_modules/", "coverage/"]
}
